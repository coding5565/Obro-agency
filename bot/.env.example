# bot/.env namunasi. Haqiqiy .env repozitoriyga tushmaydi.
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=123456789:AA...
# backend/.env dagi TELEGRAM_BOT_API_SECRET bilan bir xil bo'lishi shart
TELEGRAM_BOT_API_SECRET=uzun-tasodifiy-kalit
API_URL=http://127.0.0.1:8000/api/v1
OUTBOX_INTERVAL=10
MORNING_AT=09:00
EVENING_AT=18:30
TIMEZONE=Asia/Tashkent
